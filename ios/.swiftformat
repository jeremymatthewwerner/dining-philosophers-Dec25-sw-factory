# SwiftFormat Configuration for Dining Philosophers iOS App
# See: https://github.com/nicklockwood/SwiftFormat

# File options
--exclude .build,DiningPhilosophers.xcodeproj

# Format options
--allman false
--binarygrouping 4,8
--closingparen balanced
--commas always
--decimalgrouping 3,6
--elseposition same-line
--empty void
--exponentcase lowercase
--exponentgrouping disabled
--fractiongrouping disabled
--header strip
--hexgrouping 4,8
--hexliteralcase uppercase
--ifdef indent
--indent 4
--indentcase false
--indentstrings false
--linebreaks lf
--maxwidth 150
--octalgrouping 4,8
--operatorfunc spaced
--patternlet hoist
--ranges spaced
--self remove
--selfrequired
--semicolons inline
--shortoptionals always
--smarttabs enabled
--stripunusedargs always
--swiftversion 5.9
--tabwidth 4
--trailingclosures
--trimwhitespace always
--typeattributes prev-line
--varattributes same-line
--voidtype void
--wraparguments preserve
--wrapcollections preserve
--wrapconditions preserve
--wrapparameters preserve
--wrapreturntype preserve
--wrapternary default
--xcodeindentation disabled
--yodaswap always

# Rules
--enable isEmpty
--enable markTypes
--enable organizeDeclarations
--enable sortImports
--enable wrapEnumCases
--enable wrapSwitchCases

--disable acronyms
--disable blankLinesAtEndOfScope
--disable blankLinesAtStartOfScope
--disable redundantFileprivate
--disable trailingCommas
